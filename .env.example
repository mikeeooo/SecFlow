# Every setting SecFlow reads, with its default. Copy this file to .env and uncomment a line to change it.
# config/settings.py reads .env and the environment. The environment wins.
# A SECFLOW_* variable that is not listed here is an error, and so is any other name in .env.

# Paths. The defaults are relative to the repository root. A relative path you set here is resolved
# against the directory the process starts in.
# SECFLOW_STORAGE_DIR=storage
# SECFLOW_MANIFEST_PATH=datagen/manifest.json
# SECFLOW_MODELS_DIR=ml/models
# SECFLOW_ARTIFACTS_DIR=artifacts
# SECFLOW_POLICY_PATH=config/policy.json

# Live stream. Start it with the server, and wait this many seconds between submissions in single
# mode and in batch mode. Both intervals must be above 0.
# SECFLOW_AUTOSTART_STREAM=true
# SECFLOW_STREAM_INTERVAL=2
# SECFLOW_BATCH_INTERVAL=4
